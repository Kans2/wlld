# ==============================================
# Meme'd — Campaign Payout Tracker Environment
# ==============================================

# ----------------------------------------------
# Backend Configuration (backend/.env)
# ----------------------------------------------
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/memedtracker?retryWrites=true&w=majority
# For local MongoDB via Docker: mongodb://localhost:27017/memedtracker

# JWT Authentication Secret & Token Expiry
JWT_SECRET=your-super-secret-jwt-key-change-this-min-32-chars
JWT_EXPIRES_IN=7d

# Redis Configuration (Optional - used for caching)
REDIS_URL=redis://localhost:6379

# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# ----------------------------------------------
# Frontend Configuration (frontend/.env.local)
# ----------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api
